# Settings > Notifications, beyond the rows search finds (settings.ftl).

## Groups on the page.

settings-notifications-section-delivery = 发送方式
settings-notifications-section-toasts = 应用内提示
settings-notifications-section-sound = 声音

## Rows.

# Where agent notifications go: nowhere, Sheprd's in-app toasts, the
# terminal, or the system's notifications.
settings-notifications-delivery-off = 关闭
settings-notifications-delivery-herdr = Sheprd
settings-notifications-delivery-terminal = 终端
settings-notifications-delivery-system = 系统
settings-notifications-finished-description = 关闭后，每个智能体回合结束时不再显示应用内或系统通知；“需要关注”的通知仍会显示。
settings-notifications-position-description = 控件显示实际生效的值；受管理文件中的覆盖设置仍优先。
settings-notifications-delay-description = 延迟显示提示，让快速完成的回合保持安静。控件显示实际生效的值；受管理文件中的覆盖设置仍优先。
settings-notifications-delay-reset = 重置
settings-notifications-sound-description = 使用 Herdr 的声音路径和各智能体的覆盖设置。找不到自定义声音时会使用内置声音。
settings-notifications-sound-description-no-window = 使用 Herdr 的声音路径和各智能体的覆盖设置。找不到自定义声音时会使用内置声音。请打开 Sheprd 主窗口以预览声音。
settings-notifications-sound-test = 测试
settings-notifications-quiet-off = 关闭
