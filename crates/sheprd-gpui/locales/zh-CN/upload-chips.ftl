# A dropped file's chip while it is copied to another host, in a chat's
# composer or over a terminal: the share of it sent, as "38%", or, before
# it starts, its size, such as 2.3 MB.
upload-chips-percent = { $percent }%
upload-chips-waiting = 等待中
upload-chips-waiting-size = 等待中 · { $size }
# Under the chips while dropped files are copied. $host is its name;
# $sent and $total are sizes, such as 3.4 MB and 12.8 MB.
upload-chips-progress = 正在复制到 { $host } · { $sent } / { $total }
